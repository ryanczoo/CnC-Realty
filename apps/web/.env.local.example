# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://cnc:cnc_dev@localhost:5432/cnc_realty"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Postmark
# Server API token: Postmark dashboard -> Servers -> the server -> API Tokens
POSTMARK_SERVER_TOKEN=""
# Broadcast stream ID: Postmark dashboard -> Servers -> the server -> Message
# Streams -> the broadcast stream. Account-specific, so it cannot be hardcoded.
POSTMARK_BROADCAST_STREAM=""
# Basic Auth for the webhook endpoints. These are values you invent, not values
# Postmark issues: set them here, then embed the same pair in the webhook URL
# you configure in the dashboard, e.g.
#   https://user:password@cncrealtygroup.com/api/webhooks/postmark
POSTMARK_WEBHOOK_USER=""
POSTMARK_WEBHOOK_PASSWORD=""

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cnc-realty"

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
